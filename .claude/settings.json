{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "PowerShell(*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/check-handoff.ps1"
          },
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NonInteractive -File .claude/hooks/play-chime.ps1",
            "timeout": 12
          }
        ]
      }
    ]
  }
}