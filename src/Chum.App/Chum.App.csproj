<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\chum.ico</ApplicationIcon>
    <AssemblyTitle>Chum</AssemblyTitle>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- DXGI Desktop Duplication screen capture — verify version on NuGet if restore fails -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.DXGI" Version="3.5.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chum.Audio\Chum.Audio.csproj" />
    <ProjectReference Include="..\Chum.Transcription\Chum.Transcription.csproj" />
    <ProjectReference Include="..\Chum.Llm\Chum.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon - create a placeholder; replace with real .ico -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share IPC protocol types with service without a project reference (separate EXEs) -->
    <Compile Include="..\Chum.Service\IpcProtocol.cs" Link="Services\IpcProtocol.cs" />
  </ItemGroup>

</Project>
