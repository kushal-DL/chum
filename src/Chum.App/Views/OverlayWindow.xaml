<Window x:Class="Chum.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chum"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="420" Height="320"
        MinWidth="280" MinHeight="160"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <Style x:Key="ChumButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Record toggle: grey ● normally, red ⏹ while recording -->
        <Style x:Key="RecordButtonStyle" TargetType="Button" BasedOn="{StaticResource ChumButton}">
            <Setter Property="Content" Value="●"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Content" Value="⏹"/>
                    <Setter Property="Foreground" Value="#EF4444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!-- Screenshot (region snapshot) mode: turns purple while armed -->
        <Style x:Key="ScreenshotButtonStyle" TargetType="Button" BasedOn="{StaticResource ChumButton}">
            <Setter Property="Content" Value="▣"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScreenshotMode}" Value="True">
                    <Setter Property="Foreground" Value="#8B5CF6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Google AI Search button: turns cyan while armed -->
        <Style x:Key="GoogleSearchButtonStyle" TargetType="Button" BasedOn="{StaticResource ChumButton}">
            <Setter Property="Content" Value="G"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGoogleSearchMode}" Value="True">
                    <Setter Property="Foreground" Value="#06B6D4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
    <!-- Root: semi-transparent dark panel -->
    <Border Background="#CC1A1A1A" CornerRadius="10"
            Visibility="{Binding OverlayVisibility}">
        <Grid RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header / drag bar -->
                <RowDefinition Height="*"/>      <!-- Response area -->
                <RowDefinition Height="Auto"/>   <!-- History navigation -->
                <RowDefinition Height="Auto"/>   <!-- Notification banners -->
                <RowDefinition Height="Auto"/>   <!-- Transcript strip (collapsible) -->
                <RowDefinition Height="Auto"/>   <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Grid Grid.Row="0" Background="#221A1A1A"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status dot + text -->
                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="10,0,6,0"
                         VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding StatusColor}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"
                           Padding="0,8"/>

                <!-- Listening indicator (pulsing ring when hotkey held) -->
                <Border Grid.Column="2" Width="14" Height="14" Margin="0,0,4,0"
                        VerticalAlignment="Center" CornerRadius="7"
                        Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Background>
                        <SolidColorBrush Color="#22C55E"/>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"
                                        CenterX="7" CenterY="7"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     From="1" To="1.3" Duration="0:0:0.6"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     From="1" To="1.3" Duration="0:0:0.6"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>

                <!-- Close / settings buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Style="{StaticResource RecordButtonStyle}" Margin="2,4"
                            Click="RecordToggle_Click"/>
                    <Button Style="{StaticResource ScreenshotButtonStyle}" Margin="2,4"
                            Click="ScreenshotMode_Click"/>
                    <Button Style="{StaticResource GoogleSearchButtonStyle}" Margin="2,4"
                            ToolTip="Google AI Search — requires start-internet-search.ps1"
                            Click="GoogleSearch_Click"/>
                    <Button Style="{StaticResource ChumButton}" Content="■" Margin="2,4"
                            Click="StopResponse_Click"/>
                    <Button Style="{StaticResource ChumButton}" Content="{Binding ResponseModeLabel}"
                            Margin="2,4" Click="ModeToggle_Click"/>
                    <Border Width="1" Background="#33FFFFFF" Margin="3,6"/>
                    <Button Style="{StaticResource ChumButton}" Content="↓" Margin="2,4"
                            Click="ExportTranscript_Click"/>
                    <Button Style="{StaticResource ChumButton}" Content="⧉" Margin="2,4"
                            Click="CopyResponse_Click"/>
                    <Button Style="{StaticResource ChumButton}" Content="⚙" Margin="2,4"
                            Click="Settings_Click"/>
                    <Button Style="{StaticResource ChumButton}" Content="✕" Margin="2,4"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ── Response area ── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="10,8" x:Name="ResponseScroller">
                <TextBlock Text="{Binding ResponseText}"
                           Foreground="White"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextWrapping="Wrap"
                           FontFamily="Segoe UI"
                           LineHeight="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ScrollViewer>

            <!-- Streaming cursor -->
            <TextBlock Grid.Row="1" Text="▋" Foreground="#22C55E" FontSize="13"
                       VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       Margin="10,0,0,4"
                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="TextBlock.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <!-- ── History navigation ── -->
            <Border Grid.Row="2" Background="#10FFFFFF" Padding="6,3"
                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ChumButton}" Content="◀"
                            IsEnabled="{Binding CanGoBack}"
                            Click="HistoryPrev_Click"/>
                    <TextBlock Grid.Column="1" Text="{Binding HistoryLabel}"
                               Foreground="#666" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource ChumButton}" Content="▶"
                            IsEnabled="{Binding CanGoForward}"
                            Click="HistoryNext_Click"/>
                </Grid>
            </Border>

            <!-- ── Notification banners (disclosure + paused + clipboard) ── -->
            <StackPanel Grid.Row="3">
                <!-- Disclosure reminder — shown once on first capture start; dismissed with "Got it" -->
                <Border Background="#1FF59E0B" BorderBrush="#F59E0B"
                        BorderThickness="0,1,0,0" Padding="8,5"
                        Visibility="{Binding HasDisclosureReminder, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="ℹ Chum transcribes audio. Inform participants you're using AI assistance."
                                   Foreground="#F59E0B" FontSize="10" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Style="{StaticResource ChumButton}"
                                Content="Got it" FontSize="10"
                                Click="DismissDisclosure_Click"/>
                    </Grid>
                </Border>
                <Border Background="#1FEF4444" BorderBrush="#EF4444"
                        BorderThickness="0,1,0,0" Padding="10,6"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="⏸  Audio capture PAUSED — hotkey to resume"
                               Foreground="#EF4444" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <Border Background="#1FFBBF24" BorderBrush="#FBBF24"
                        BorderThickness="0,1,0,0" Padding="10,5"
                        Visibility="{Binding HasPendingClipboardImage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Image in clipboard — press Ctrl+Alt+S to analyse"
                               Foreground="#FBBF24" FontSize="11"/>
                </Border>
                <Border Background="#1F8B5CF6" BorderBrush="#8B5CF6"
                        BorderThickness="0,1,0,0" Padding="10,5"
                        Visibility="{Binding HasPendingScreenCapture, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="⚠  Screenshot pending — press Ctrl+Alt+S again to send (5s to cancel)"
                               Foreground="#8B5CF6" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <!-- Screenshot (region snapshot) mode hint -->
                <Border Background="#1F8B5CF6" BorderBrush="#8B5CF6"
                        BorderThickness="0,1,0,0" Padding="10,5"
                        Visibility="{Binding IsScreenshotMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ScreenshotHint}"
                               Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>
                <!-- Audio device mismatch — shown when Teams/Zoom uses a different device than Chum's loopback -->
                <Border Background="#1F06B6D4" BorderBrush="#06B6D4"
                        BorderThickness="0,1,0,0" Padding="8,5"
                        Visibility="{Binding HasAudioDeviceMismatch, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding AudioDeviceMismatchMessage}"
                                   Foreground="#06B6D4" FontSize="10" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Style="{StaticResource ChumButton}"
                                Content="Switch" FontSize="10" Margin="0,0,4,0"
                                Click="AudioSwitch_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource ChumButton}"
                                Content="Keep" FontSize="10"
                                Click="AudioDismiss_Click"/>
                    </Grid>
                </Border>
                <!-- Compact audio level meters — loopback + mic -->
                <Border Background="#08111111" Padding="8,3,8,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LB" Foreground="#3A3A3A" FontSize="9"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ProgressBar Grid.Column="1" Value="{Binding LoopbackLevelPct, Mode=OneWay}"
                                     Minimum="0" Maximum="1" Height="4" BorderThickness="0"
                                     Foreground="#22C55E" Background="#1AFFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="MIC" Foreground="#3A3A3A" FontSize="9"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ProgressBar Grid.Column="4" Value="{Binding MicLevelPct, Mode=OneWay}"
                                     Minimum="0" Maximum="1" Height="4" BorderThickness="0"
                                     Foreground="#22C55E" Background="#1AFFFFFF" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ── Transcript strip (collapsed by default) ── -->
            <Expander Grid.Row="4" Header="Transcript" Foreground="#777"
                      FontSize="10" Margin="6,0" IsExpanded="False">
                <ItemsControl ItemsSource="{Binding TranscriptLines}" Margin="4,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#999" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!-- ── Status bar ── -->
            <Border Grid.Row="5" Background="#15FFFFFF" CornerRadius="0,0,10,10">
                <Grid Margin="10,4">
                    <TextBlock Text="Chum v0.1" Foreground="#444" FontSize="10"
                               HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding LastQueryCostHint}"
                               Foreground="#555" FontSize="10" FontFamily="Consolas"
                               HorizontalAlignment="Center"
                               Visibility="{Binding HasCostHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="Ctrl+Alt+Space: start/stop · Ctrl+Alt+H: hide"
                               Foreground="#444" FontSize="10" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
    <!-- Invisible resize handle: manual WPF resize (no P/Invoke, no cursor change) -->
    <Border Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="Arrow"
            MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
            MouseMove="ResizeGrip_MouseMove"
            MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
    </Grid>
</Window>
