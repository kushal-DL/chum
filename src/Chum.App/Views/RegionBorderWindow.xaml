<Window x:Class="Chum.App.Views.RegionBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">
    <Border x:Name="RegionBorder"
            BorderThickness="2"
            BorderBrush="#22D3EE"
            Background="Transparent"/>
</Window>
