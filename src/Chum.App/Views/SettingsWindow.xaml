<Window x:Class="Chum.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chum Settings"
        Width="500" Height="540"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Label" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Chum Settings" Foreground="White" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="v0.1.0" Foreground="#666" FontSize="11"/>

            <!-- ── API Keys ── -->
            <Label Content="AI PROVIDER" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Anthropic API Key" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="AnthropicKeyBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="Save" Margin="6,0,0,0" Click="SaveAnthropicKey_Click"/>
                <Button Grid.Column="2" Content="Test" Margin="6,0,0,0" Background="#22C55E"
                        Click="TestAnthropicKey_Click"/>
            </Grid>
            <TextBlock x:Name="AnthropicKeyStatus" Foreground="#22C55E" FontSize="11"
                       Margin="0,4,0,0" Text="" Visibility="Collapsed"/>

            <TextBlock Text="Model" Foreground="#999" FontSize="11" Margin="0,8,0,2"/>
            <ComboBox x:Name="ModelCombo" SelectedValuePath="Tag">
                <ComboBoxItem Content="Claude Haiku 4.5 — Fast, cheap (recommended)" Tag="claude-haiku-4-5-20251001" IsSelected="True"/>
                <ComboBoxItem Content="Claude Sonnet 4.6 — Higher quality, vision" Tag="claude-sonnet-4-6"/>
            </ComboBox>

            <!-- ── Transcription ── -->
            <Label Content="TRANSCRIPTION" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Whisper model size" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
            <ComboBox x:Name="WhisperModelCombo">
                <ComboBoxItem Content="Tiny (39 MB) — fastest, lowest accuracy" Tag="Tiny"/>
                <ComboBoxItem Content="Base (74 MB) — fast, decent accuracy" Tag="Base"/>
                <ComboBoxItem Content="Small (244 MB) — recommended balance" Tag="Small" IsSelected="True"/>
                <ComboBoxItem Content="Medium (769 MB) — high accuracy, slow on CPU" Tag="Medium"/>
            </ComboBox>
            <TextBlock Text="Model is downloaded to %LOCALAPPDATA%\Chum\Models on first use."
                       Foreground="#555" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <!-- ── Hotkeys ── -->
            <Label Content="HOTKEYS" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hold to Ask" Foreground="#999" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HoldToAskBox" Text="Ctrl+Alt+Space" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen Capture" Foreground="#999" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ScreenCapBox" Text="Ctrl+Alt+S" Margin="0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Privacy Pause" Foreground="#999" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="PrivacyPauseBox" Text="Ctrl+Alt+P" Margin="0,4"/>
            </Grid>

            <!-- ── Appearance ── -->
            <Label Content="APPEARANCE" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Overlay opacity" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
            <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="0.95" Value="0.85"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>

            <!-- ── Misc ── -->
            <Label Content="BEHAVIOUR" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Margin="0,4"/>
            <CheckBox x:Name="StartCapturingBox" Content="Start capturing audio on launch" Margin="0,4" IsChecked="True"/>
            <CheckBox x:Name="AutoHideShareBox" Content="Auto-hide overlay when screen sharing" Margin="0,4" IsChecked="True"/>

            <!-- ── Buttons ── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Background="#444" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save Settings" Click="SaveSettings_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
