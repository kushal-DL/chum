<Window x:Class="Chum.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chum Settings"
        Width="500" Height="740"
        Background="#F9FAFB"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Label" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Chum Settings" Foreground="#111827" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="v0.1.0" Foreground="#9CA3AF" FontSize="11"/>

            <!-- AI Provider -->
            <Label Content="AI PROVIDER" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Provider" Foreground="#374151" FontSize="11" Margin="0,0,0,3"/>
            <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderCombo_SelectionChanged">
                <ComboBoxItem Content="Anthropic (Claude)" Tag="Anthropic"/>
                <ComboBoxItem Content="OpenAI (GPT)" Tag="OpenAI"/>
                <ComboBoxItem Content="NVIDIA NIM (OpenAI-compatible)" Tag="NVIDIA"/>
                <ComboBoxItem Content="Ollama (local)" Tag="Ollama"/>
                <ComboBoxItem Content="Custom (OpenAI-compatible)" Tag="Custom"/>
            </ComboBox>

            <!-- API Base URL — shown for OpenAI / NVIDIA / Custom -->
            <StackPanel x:Name="ApiUrlPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBlock Text="API Base URL" Foreground="#374151" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="ApiBaseUrlBox" ToolTip="e.g. https://integrate.api.nvidia.com/v1"/>
                <TextBlock Text="Leave blank to use the provider default endpoint."
                           Style="{StaticResource Hint}"/>
            </StackPanel>

            <!-- API Key — shown for Anthropic / OpenAI / NVIDIA / Custom -->
            <StackPanel x:Name="ApiKeyPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBlock x:Name="ApiKeyLabel" Text="API Key" Foreground="#374151" FontSize="11" Margin="0,0,0,3"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="Save" Margin="6,0,0,0" Click="SaveApiKey_Click"/>
                    <Button Grid.Column="2" Content="Test" Margin="6,0,0,0" Background="#16A34A"
                            Click="TestApiKey_Click"/>
                </Grid>
                <TextBlock x:Name="ApiKeyStatus" Foreground="#16A34A" FontSize="11"
                           Margin="0,4,0,0" Text="" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Ollama URL — shown only for Ollama -->
            <StackPanel x:Name="OllamaInlinePanel" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBlock Text="Ollama Base URL" Foreground="#374151" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="OllamaInlineUrlBox" Text="http://localhost:11434"/>
            </StackPanel>

            <!-- Model — always shown -->
            <TextBlock Text="Model" Foreground="#374151" FontSize="11" Margin="0,8,0,3"/>
            <TextBox x:Name="ModelCombo"
                     ToolTip="Model identifier — e.g. nvidia/nemotron-3-nano-omni-30b-a3b-reasoning, gpt-4o, claude-haiku-4-5-20251001"/>
            <TextBlock Text="Enter the exact model ID for your selected provider."
                       Style="{StaticResource Hint}"/>

            <!-- Audio Devices -->
            <Label Content="AUDIO DEVICES" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Loopback source (meeting audio)" Foreground="#374151" FontSize="11" Margin="0,0,0,2"/>
            <ComboBox x:Name="LoopbackDeviceCombo"/>
            <TextBlock Text="Captures all audio playing through this output device."
                       Style="{StaticResource Hint}"/>
            <TextBlock Text="Microphone source" Foreground="#374151" FontSize="11" Margin="0,8,0,2"/>
            <ComboBox x:Name="MicDeviceCombo"/>
            <TextBlock Text="Captures your own voice. Use a USB or 3.5mm headset for best transcription quality."
                       Style="{StaticResource Hint}"/>

            <!-- Transcription -->
            <Label Content="TRANSCRIPTION" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Whisper model size" Foreground="#374151" FontSize="11" Margin="0,0,0,2"/>
            <ComboBox x:Name="WhisperModelCombo">
                <ComboBoxItem Content="Tiny (39 MB) — fastest, lowest accuracy" Tag="Tiny"/>
                <ComboBoxItem Content="Base (74 MB) — fast, decent accuracy" Tag="Base"/>
                <ComboBoxItem Content="Small (244 MB) — recommended balance" Tag="Small" IsSelected="True"/>
                <ComboBoxItem Content="Medium (769 MB) — high accuracy, slower on CPU" Tag="Medium"/>
            </ComboBox>
            <TextBlock Text="Model downloads to %LOCALAPPDATA%\Chum\Models on first use. GPU acceleration: NVIDIA CUDA only in current build."
                       Style="{StaticResource Hint}"/>

            <!-- Hotkeys -->
            <Label Content="HOTKEYS" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hold to Ask" Foreground="#374151" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HoldToAskBox" Text="Ctrl+Alt+Space" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen Capture" Foreground="#374151" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ScreenCapBox" Text="Ctrl+Alt+S" Margin="0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Privacy Pause" Foreground="#374151" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="PrivacyPauseBox" Text="Ctrl+Alt+P" Margin="0,4"/>
            </Grid>

            <!-- Appearance -->
            <Label Content="APPEARANCE" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Overlay opacity" Foreground="#374151" FontSize="11" Margin="0,0,0,2"/>
            <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="0.95" Value="0.85"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>

            <!-- Behaviour -->
            <Label Content="BEHAVIOUR" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Margin="0,4"/>
            <CheckBox x:Name="StartCapturingBox" Content="Start capturing audio on launch" Margin="0,4" IsChecked="True"/>
            <CheckBox x:Name="AutoHideShareBox" Content="Auto-hide overlay when screen sharing" Margin="0,4" IsChecked="True"/>
            <CheckBox x:Name="ExcludeFromCaptureBox"
                      Content="Hide overlay from screen captures and recordings (recommended)"
                      Margin="0,4" IsChecked="True"
                      ToolTip="Uses Windows WDA_EXCLUDEFROMCAPTURE so the overlay is invisible in screen shares, OBS, Teams recordings, etc. Your physical screen is unaffected. Requires Windows 10 2004+."/>
            <CheckBox x:Name="ConfirmScreenCaptureBox"
                      Content="Require confirmation before sending screenshot to AI"
                      Margin="0,4"
                      ToolTip="When enabled, the first Ctrl+Alt+S shows a banner. Press again within 5 seconds to actually send the screenshot. Prevents accidental capture of sensitive content."/>
            <CheckBox x:Name="AutoStartCaptureBox"
                      Content="Auto-start capture when Teams, Zoom, or Google Meet is detected"
                      Margin="0,4"
                      ToolTip="Chum checks for running meeting apps every 5 seconds. Capture starts automatically when one is found and stops when it closes."/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Spend alert threshold (USD):" Foreground="#374151" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="SpendThresholdBox" Width="60" Margin="8,0,0,0"
                         ToolTip="Warn in overlay when session API spend exceeds this amount in USD. Set to 0 to disable."/>
            </StackPanel>

            <!-- Cloud STT Fallback -->
            <Label Content="CLOUD STT FALLBACK (OPENAI WHISPER)" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="CloudSttFallbackBox"
                      Content="Fall back to OpenAI Whisper API when local STT fails"
                      Margin="0,4"
                      ToolTip="Uses your OpenAI API key. Falls back automatically if local Whisper cannot initialize. Billed per minute of audio."/>
            <TextBlock Text="Cloud STT model" Foreground="#374151" FontSize="11" Margin="0,8,0,2"/>
            <TextBox x:Name="CloudSttModelBox" Text="whisper-1"/>

            <!-- Local Processing -->
            <Label Content="LOCAL PROCESSING (OLLAMA)" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="LocalOnlyModeBox"
                      Content="Local-only mode — route all AI calls through Ollama (no cloud)"
                      Margin="0,4" IsChecked="False"/>
            <TextBlock Text="Requires Ollama running locally. No API keys needed. Data never leaves your machine."
                       Style="{StaticResource Hint}"/>
            <TextBlock Text="Ollama model name" Foreground="#374151" FontSize="11" Margin="0,8,0,2"/>
            <TextBox x:Name="OllamaModelBox" Text="llama3.1:8b"/>
            <TextBlock Text="For vision queries use a multimodal model (e.g. llava, llava-llama3)."
                       Style="{StaticResource Hint}"/>
            <TextBlock Text="Ollama base URL" Foreground="#374151" FontSize="11" Margin="0,8,0,2"/>
            <TextBox x:Name="OllamaUrlBox" Text="http://localhost:11434"/>

            <!-- Prompt Templates -->
            <Label Content="PROMPT TEMPLATES" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Active template (or press Ctrl+Alt+1–5 during a meeting):"
                       Foreground="#374151" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="ActiveTemplateCombo" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="#374151" FontSize="11" VerticalAlignment="Center"/>
                <TextBox x:Name="TemplateNameBox" Grid.Row="0" Grid.Column="1"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="System prompt:" Foreground="#374151" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox x:Name="TemplateSuffixBox" Grid.Row="1" Grid.Column="1"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,4,0,0"
                         VerticalScrollBarVisibility="Auto"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="AddTemplateBtn" Content="Add / Update" Padding="8,4" Margin="0,0,6,0"
                            Background="#F3F4F6" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1"
                            Click="AddTemplate_Click" Cursor="Hand"/>
                    <Button x:Name="DeleteTemplateBtn" Content="Delete" Padding="8,4"
                            Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1"
                            Click="DeleteTemplate_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Built-in templates (Default, Quick Answer, Detailed Explanation, Action Items, Devil's Advocate) cannot be deleted."
                       Style="{StaticResource Hint}"/>

            <!-- Privacy -->
            <Label Content="PRIVACY" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Transcript retention" Foreground="#374151" FontSize="11" Margin="0,0,0,2"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="RetentionSlider" Grid.Column="0" Minimum="1" Maximum="120" Value="10"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="RetentionSlider_ValueChanged"/>
                <TextBlock x:Name="RetentionLabel" Grid.Column="1" Text="10 min"
                           Foreground="#374151" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock Text="Transcript segments older than this are purged from memory automatically."
                       Style="{StaticResource Hint}"/>
            <CheckBox x:Name="DisclosureReminderBox"
                      Content="Show disclosure reminder when capture starts"
                      Margin="0,8,0,0"/>
            <TextBlock Text="Reminds you to inform meeting participants that AI assistance is active."
                       Style="{StaticResource Hint}" Margin="16,2,0,0"/>

            <!-- Document Context -->
            <Label Content="DOCUMENT CONTEXT" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Attach documents so Chum can reference them when answering questions."
                       Style="{StaticResource Hint}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Add PDF / TXT file…" Padding="10,5"
                        Background="#F3F4F6" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1"
                        Click="AddDocument_Click" Margin="0,0,8,0"/>
                <Button Content="Remove selected" Padding="10,5"
                        Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1"
                        Click="RemoveDocument_Click"/>
            </StackPanel>
            <ListBox x:Name="DocumentList" Height="80" Background="White" BorderBrush="#D1D5DB"
                     BorderThickness="1" FontSize="11" Foreground="#374151"/>
            <TextBlock Text="Stored in %APPDATA%\Chum\documents.json — included in every LLM query."
                       Style="{StaticResource Hint}"/>

            <!-- Buttons -->
            <Grid Margin="0,20,0,0">
                <Button Content="About &amp; Diagnostics" HorizontalAlignment="Left"
                        Background="#F3F4F6" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1"
                        Click="About_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Background="#F3F4F6" Foreground="#374151"
                            BorderBrush="#D1D5DB" BorderThickness="1"
                            Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="Save Settings" Click="SaveSettings_Click"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
