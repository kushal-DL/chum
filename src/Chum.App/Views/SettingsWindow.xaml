<Window x:Class="Chum.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chum Settings"
        Width="500" Height="720"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Label" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Chum Settings" Foreground="White" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="v0.1.0" Foreground="#666" FontSize="11"/>

            <!-- ── API Keys ── -->
            <Label Content="AI PROVIDER" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Anthropic API Key" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="AnthropicKeyBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="Save" Margin="6,0,0,0" Click="SaveAnthropicKey_Click"/>
                <Button Grid.Column="2" Content="Test" Margin="6,0,0,0" Background="#22C55E"
                        Click="TestAnthropicKey_Click"/>
            </Grid>
            <TextBlock x:Name="AnthropicKeyStatus" Foreground="#22C55E" FontSize="11"
                       Margin="0,4,0,0" Text="" Visibility="Collapsed"/>

            <TextBlock Text="OpenAI API Key" Foreground="#999" FontSize="11" Margin="0,8,0,2"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="OpenAiKeyBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="Save" Margin="6,0,0,0" Click="SaveOpenAiKey_Click"/>
            </Grid>
            <TextBlock x:Name="OpenAiKeyStatus" Foreground="#22C55E" FontSize="11"
                       Margin="0,4,0,0" Text="" Visibility="Collapsed"/>

            <TextBlock Text="Model" Foreground="#999" FontSize="11" Margin="0,8,0,2"/>
            <ComboBox x:Name="ModelCombo" SelectedValuePath="Tag">
                <ComboBoxItem Content="Claude Haiku 4.5 — Fast, cheap (recommended)" Tag="claude-haiku-4-5-20251001" IsSelected="True"/>
                <ComboBoxItem Content="Claude Sonnet 4.6 — Higher quality, vision" Tag="claude-sonnet-4-6"/>
                <ComboBoxItem Content="GPT-4o Mini — Fast, cheap (OpenAI)" Tag="gpt-4o-mini"/>
                <ComboBoxItem Content="GPT-4o — Higher quality, vision (OpenAI)" Tag="gpt-4o"/>
            </ComboBox>

            <!-- ── Audio Devices ── -->
            <Label Content="AUDIO DEVICES" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Loopback source (meeting audio)" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
            <ComboBox x:Name="LoopbackDeviceCombo"/>
            <TextBlock Text="Captures all audio playing through this output device."
                       Foreground="#555" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Microphone source" Foreground="#999" FontSize="11" Margin="0,8,0,2"/>
            <ComboBox x:Name="MicDeviceCombo"/>
            <TextBlock Text="Captures your own voice. Use a USB or 3.5mm headset for best transcription quality."
                       Foreground="#555" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <!-- ── Transcription ── -->
            <Label Content="TRANSCRIPTION" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Whisper model size" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
            <ComboBox x:Name="WhisperModelCombo">
                <ComboBoxItem Content="Tiny (39 MB) — fastest, lowest accuracy" Tag="Tiny"/>
                <ComboBoxItem Content="Base (74 MB) — fast, decent accuracy" Tag="Base"/>
                <ComboBoxItem Content="Small (244 MB) — recommended balance" Tag="Small" IsSelected="True"/>
                <ComboBoxItem Content="Medium (769 MB) — high accuracy, slow on CPU" Tag="Medium"/>
            </ComboBox>
            <TextBlock Text="Model is downloaded to %LOCALAPPDATA%\Chum\Models on first use."
                       Foreground="#555" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <!-- ── Hotkeys ── -->
            <Label Content="HOTKEYS" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hold to Ask" Foreground="#999" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HoldToAskBox" Text="Ctrl+Alt+Space" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen Capture" Foreground="#999" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ScreenCapBox" Text="Ctrl+Alt+S" Margin="0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Privacy Pause" Foreground="#999" FontSize="11" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="PrivacyPauseBox" Text="Ctrl+Alt+P" Margin="0,4"/>
            </Grid>

            <!-- ── Appearance ── -->
            <Label Content="APPEARANCE" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Overlay opacity" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
            <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="0.95" Value="0.85"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>

            <!-- ── Misc ── -->
            <Label Content="BEHAVIOUR" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Margin="0,4"/>
            <CheckBox x:Name="StartCapturingBox" Content="Start capturing audio on launch" Margin="0,4" IsChecked="True"/>
            <CheckBox x:Name="AutoHideShareBox" Content="Auto-hide overlay when screen sharing" Margin="0,4" IsChecked="True"/>
            <CheckBox x:Name="ExcludeFromCaptureBox" Content="Hide overlay from screen captures and recordings (recommended)"
                      Margin="0,4" IsChecked="True" ToolTip="Uses Windows WDA_EXCLUDEFROMCAPTURE so the overlay is invisible in screen shares, OBS, Teams recordings, etc. Your physical screen is unaffected. Requires Windows 10 2004+."/>
            <CheckBox x:Name="ConfirmScreenCaptureBox"
                      Content="Require confirmation before sending screenshot to AI"
                      Margin="0,4"
                      ToolTip="When enabled, the first Ctrl+Alt+S shows a banner. Press again within 5 seconds to actually send the screenshot. Prevents accidental capture of sensitive content."/>
            <CheckBox x:Name="AutoStartCaptureBox"
                      Content="Auto-start capture when Teams, Zoom, or Google Meet is detected"
                      Margin="0,4"
                      ToolTip="Chum checks for running meeting apps every 5 seconds. Capture starts automatically when one is found and stops when it closes. Overrides the 'Start capturing on launch' setting during that session."/>
            <CheckBox x:Name="UseTeamsCaptionsBox"
                      Content="Read Teams live captions via accessibility API (supplementary transcript)"
                      Margin="0,4"
                      ToolTip="When enabled and Teams is detected, Chum reads Teams' own live captions via Windows UI Automation and merges them with the audio transcript. Requires Teams auto-captions to be enabled in the meeting. Off by default."/>
            <CheckBox x:Name="AutoLowPowerBox"
                      Content="Auto-enable low-power mode on battery"
                      Margin="0,4"
                      ToolTip="When running on battery, Chum reduces GC frequency. Restart required to switch to a smaller Whisper model for lower CPU usage."/>
            <CheckBox x:Name="ForceLowPowerBox"
                      Content="Force low-power mode (regardless of power source)"
                      Margin="0,4"
                      ToolTip="Permanently enables low-power mode. Useful on plugged-in systems where you want to minimise Chum's CPU impact."/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Label Content="Spend alert threshold (USD):" Foreground="#AAAAAA" FontSize="11" Padding="0" VerticalAlignment="Center"/>
                <TextBox x:Name="SpendThresholdBox" Width="60" Margin="8,0,0,0"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                         ToolTip="Warn in overlay when session API spend exceeds this amount in USD. Set to 0 to disable."/>
            </StackPanel>

            <!-- ── Cloud STT Fallback ── -->
            <Label Content="CLOUD STT FALLBACK (OPENAI WHISPER)" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="CloudSttFallbackBox"
                      Content="Fall back to OpenAI Whisper API when local STT fails or is unavailable"
                      Margin="0,4"
                      ToolTip="Uses your OpenAI API key. Falls back automatically if local Whisper cannot initialize (e.g., model not downloaded, insufficient RAM). Billed per minute of audio."/>
            <TextBlock Text="Cloud STT model" Foreground="#999" FontSize="11" Margin="0,8,0,2"/>
            <TextBox x:Name="CloudSttModelBox" Text="whisper-1"/>

            <!-- ── Local Processing ── -->
            <Label Content="LOCAL PROCESSING (OLLAMA)" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="LocalOnlyModeBox"
                      Content="Local-only mode — route all AI calls through Ollama (no cloud)"
                      Margin="0,4" IsChecked="False"/>
            <TextBlock Text="Requires Ollama running locally. No API keys needed. Data never leaves your machine."
                       Foreground="#555" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Ollama model name" Foreground="#999" FontSize="11" Margin="0,8,0,2"/>
            <TextBox x:Name="OllamaModelBox" Text="llama3.1:8b"/>
            <TextBlock Text="For vision queries use a multimodal model (e.g. llava, llava-llama3)."
                       Foreground="#555" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Ollama base URL" Foreground="#999" FontSize="11" Margin="0,8,0,2"/>
            <TextBox x:Name="OllamaUrlBox" Text="http://localhost:11434"/>

            <!-- ── Prompt Templates ── -->
            <Label Content="PROMPT TEMPLATES" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Active template (or press Ctrl+Alt+1–5 during a meeting):"
                       Foreground="#999" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="ActiveTemplateCombo" Margin="0,0,0,8"
                      Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                <TextBox x:Name="TemplateNameBox" Grid.Row="0" Grid.Column="1"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="System prompt:" Foreground="#999" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox x:Name="TemplateSuffixBox" Grid.Row="1" Grid.Column="1"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,4,0,0"
                         VerticalScrollBarVisibility="Auto"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="AddTemplateBtn" Content="Add / Update" Padding="8,4" Margin="0,0,6,0"
                            Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                            Click="AddTemplate_Click" Cursor="Hand"/>
                    <Button x:Name="DeleteTemplateBtn" Content="Delete" Padding="8,4"
                            Background="#2D2D2D" Foreground="#EF4444" BorderBrush="#555"
                            Click="DeleteTemplate_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Built-in templates (Default, Quick Answer, Detailed Explanation, Action Items, Devil's Advocate) cannot be deleted."
                       Foreground="#555" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>

            <!-- ── Privacy ── -->
            <Label Content="PRIVACY" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Transcript retention" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="RetentionSlider" Grid.Column="0" Minimum="1" Maximum="120" Value="10"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="RetentionSlider_ValueChanged"/>
                <TextBlock x:Name="RetentionLabel" Grid.Column="1" Text="10 min"
                           Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock Text="Transcript segments older than this are purged from memory automatically."
                       Foreground="#555" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <CheckBox x:Name="DisclosureReminderBox"
                      Content="Show disclosure reminder when capture starts"
                      Foreground="#AAAAAA" Margin="0,8,0,0"/>
            <TextBlock Text="Reminds you to inform meeting participants that AI assistance is active."
                       Foreground="#555" FontSize="10" Margin="16,2,0,0" TextWrapping="Wrap"/>
            <CheckBox x:Name="CrashReportingBox"
                      Content="Enable crash reporting (saves local report file on crash)"
                      Foreground="#AAAAAA" Margin="0,8,0,0"
                      ToolTip="When enabled, Chum writes a structured JSON crash report to %LOCALAPPDATA%\Chum\CrashReports\ on unexpected errors. No data is sent automatically — you can review and share the file with support. Default: off."/>
            <TextBlock Text="Reports are saved locally in %LOCALAPPDATA%\Chum\CrashReports\ and never uploaded automatically."
                       Foreground="#555" FontSize="10" Margin="16,2,0,0" TextWrapping="Wrap"/>

            <!-- ── Backup / Restore ── -->
            <Label Content="BACKUP &amp; RESTORE" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Export or import all settings and prompt templates as a JSON backup file."
                       Foreground="#555" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Export Settings…" Padding="10,5" Background="#2D2D2D"
                        Click="ExportSettings_Click" Margin="0,0,8,0"/>
                <Button Content="Import Settings…" Padding="10,5" Background="#2D2D2D"
                        Click="ImportSettings_Click"/>
            </StackPanel>

            <!-- ── Buttons ── -->
            <Grid Margin="0,20,0,0">
                <Button Content="About &amp; Diagnostics" HorizontalAlignment="Left"
                        Background="#2D2D2D" Click="About_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Background="#444" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="Save Settings" Click="SaveSettings_Click"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
