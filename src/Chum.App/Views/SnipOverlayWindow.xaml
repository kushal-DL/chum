<Window x:Class="Chum.App.Views.SnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chum Snip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <!-- Dark dimming overlay with selection canvas layered on top -->
    <Grid>
        <!-- Semi-transparent dim layer -->
        <Border Background="#661A1A1A"/>

        <!-- Hint text centred at top -->
        <TextBlock Text="Draw a region to capture  ·  ESC to cancel"
                   Foreground="White" FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,40,0,0" Opacity="0.85"
                   x:Name="HintText"/>

        <!-- Canvas for the selection rectangle -->
        <Canvas x:Name="SelectionCanvas">
            <Border x:Name="SelectionBorder"
                    BorderBrush="#22C55E" BorderThickness="2"
                    Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Color="#22C55E" Opacity="0.12"/>
                </Border.Background>
            </Border>
        </Canvas>
    </Grid>
</Window>
